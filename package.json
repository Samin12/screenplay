{
  "name": "screenplay",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic motion-edit engine: talking head + code-built app replicas with a scripted cursor, callouts, lifts, chapter grids and stage diagrams, all anchored to spoken words.",
  "type": "module",
  "bin": {
    "screenplay": "./cli/screenplay.ts"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test cli/test/*.test.ts",
    "screenplay": "node cli/screenplay.ts",
    "compile": "node cli/screenplay.ts compile",
    "check": "node cli/screenplay.ts check",
    "test:cli": "node --test cli/test/anchors-*.test.ts cli/test/compile-*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/paths": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/shapes": "4.0.539",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
